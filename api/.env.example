# Which model provider to use: mock (no key needed), openai or anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Database: postgres (default) or memory (in-memory, for a quick try without a database)
DB_TYPE=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aichat

# Token budget for what is sent to the model on each turn
CONTEXT_BUDGET_TOKENS=6000
REPLY_RESERVE_TOKENS=1000
MAX_REPLY_TOKENS=800

PORT=3001
WEB_ORIGIN=http://localhost:3000
